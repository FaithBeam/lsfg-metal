#!/bin/zsh
# SPDX-License-Identifier: GPL-3.0-or-later
#
# lsfg-metal-crossover - run CrossOver bottles with lsfg-metal frame generation.
#
#   lsfg-metal-crossover enable  <bottle>             add lsfg-metal to the bottle's environment
#   lsfg-metal-crossover disable <bottle>             remove it again
#   lsfg-metal-crossover run [options] <bottle> <program> [args...]
#   lsfg-metal-crossover setup                        (re)create the patched CrossOver copy
#
# run options: -m N, -f F, -p, --pacing P, --dll PATH, --log FILE, --debug (see lsfg-metal-run)
# global options: --app PATH (CrossOver.app, default: auto-detect), --lib PATH (liblsfg-metal.dylib)
#
# Example:  lsfg-metal-crossover enable Steam
#           lsfg-metal-crossover run Steam "C:\Program Files (x86)\Steam\steam.exe"
#
# Why this is needed: CrossOver's Wine loader uses the hardened runtime without the
# allow-dyld-environment-variables entitlement, so macOS ignores DYLD_INSERT_LIBRARIES for it,
# and its 'wine' launcher is a perl script (SIP strips DYLD_* from it). This script does NOT
# modify CrossOver.app. 'setup' makes an APFS clone of its CrossOver directory (no extra disk
# space) in ~/Library/Application Support/lsfg-metal/crossover and re-signs only the clone's
# Wine loader ad-hoc with the same entitlements plus allow-dyld-environment-variables.
# 'enable' copies liblsfg-metal.dylib to ~/Library/Application Support/lsfg-metal (a fixed path
# that survives upgrades, e.g. Homebrew's versioned Cellar path) and adds DYLD_INSERT_LIBRARIES
# pointing at that copy to the bottle's [EnvironmentVariables], which the clone honours and the
# unmodified CrossOver ignores. 'run' refreshes the copy from the installed library. Games
# started from the CrossOver window therefore run without lsfg-metal; games started with 'run'
# (or from a Steam/launcher started with 'run') get it. The clone is refreshed automatically when CrossOver is updated.
# ARM64 bottles (CrossOver 27+) use a loader that can't be re-signed; for them the clone's
# winemac.so loads the library instead, and 'run' disables it unless the bottle is enabled.

set -e
setopt extended_glob

script_dir=${0:A:h}
lib=""
for candidate in "$script_dir/../lib/liblsfg-metal.dylib" "$script_dir/liblsfg-metal.dylib" \
                 "$script_dir/../build/liblsfg-metal.dylib"; do
    if [[ -f $candidate ]]; then lib=${candidate:A}; break; fi
done
app=""
clone="${LSFG_METAL_CROSSOVER_DIR:-$HOME/Library/Application Support/lsfg-metal/crossover}"
stable_lib="${clone:h}/liblsfg-metal.dylib"
conf_re='^"DYLD_INSERT_LIBRARIES" = ".*liblsfg-metal\.dylib"$'

die() { print -u2 "lsfg-metal-crossover: $*"; exit 1 }

find_app() {
    [[ -n $app ]] && { [[ -d $app ]] || die "no such app: $app"; return }
    for candidate in /Applications/CrossOver.app ~/Applications/CrossOver.app \
                     /Applications/CrossOver*.app(N) ~/Applications/CrossOver*.app(N); do
        if [[ -d $candidate/Contents/SharedSupport/CrossOver ]]; then app=${candidate:A}; return; fi
    done
    die "CrossOver.app not found (use --app PATH)"
}

# identifies the CrossOver build a clone was made from, plus the clone format (bump it when setup
# changes, so existing clones are rebuilt)
app_version() {
    print -r -- "$app $(/usr/libexec/PlistBuddy -c 'Print :CFBundleVersion' "$app/Contents/Info.plist" 2>/dev/null) format 2"
}

# Appends an LC_LOAD_WEAK_DYLIB load command for $2 to the thin 64-bit Mach-O $1, in the padding
# after the existing load commands. Does nothing if it is already there. The file must be re-signed.
add_weak_dylib() {
    perl - "$1" "$2" <<'EOF'
use strict;
my ($file, $name) = @ARGV;
open(my $fh, '+<:raw', $file) or die "$file: $!\n";
read($fh, my $hdr, 32) == 32 or die "$file: short read\n";
my ($magic, undef, undef, undef, $ncmds, $sizeofcmds) = unpack('V6', $hdr);
die "$file: not a thin 64-bit Mach-O\n" unless $magic == 0xfeedfacf;
read($fh, my $cmds, $sizeofcmds) == $sizeofcmds or die "$file: short read\n";
my ($off, $first) = (0, undef);
for (1 .. $ncmds) {
    my ($cmd, $size) = unpack('V2', substr($cmds, $off, 8));
    if ($cmd == 0x19) {                                     # LC_SEGMENT_64: find the first section
        my $nsects = unpack('V', substr($cmds, $off + 64, 4));
        for my $i (0 .. $nsects - 1) {
            my $s = $off + 72 + $i * 80;
            my $soff = unpack('V', substr($cmds, $s + 48, 4));
            my $type = unpack('V', substr($cmds, $s + 64, 4)) & 0xff;
            next if $type == 0x01 || $type == 0x0c || $type == 0x12;   # zerofill
            $first = $soff if $soff && (!defined $first || $soff < $first);
        }
    } elsif ($cmd == 0xc || $cmd == 0x80000018) {           # LC_LOAD_DYLIB / LC_LOAD_WEAK_DYLIB
        my $noff = unpack('V', substr($cmds, $off + 8, 4));
        my ($n) = unpack('Z*', substr($cmds, $off + $noff, $size - $noff));
        exit 0 if $n eq $name;
    }
    $off += $size;
}
die "$file: no sections\n" unless defined $first;
my $cmdsize = (24 + length($name) + 1 + 7) & ~7;
my $free = $first - 32 - $sizeofcmds;
die "$file: not enough header space ($cmdsize bytes needed, $free free)\n" if $cmdsize > $free;
seek($fh, 32 + $sizeofcmds, 0);
read($fh, my $gap, $cmdsize);
die "$file: header padding is not empty\n" if $gap =~ /[^\0]/;
my $lc = pack('V6', 0x80000018, $cmdsize, 24, 2, 0, 0) . $name;
seek($fh, 32 + $sizeofcmds, 0);
print $fh $lc . "\0" x ($cmdsize - length($lc));
seek($fh, 16, 0);
print $fh pack('V2', $ncmds + 1, $sizeofcmds + $cmdsize);
close($fh) or die "$file: $!\n";
EOF
}

# ARM64 bottles run lib/wine/aarch64-unix/wine.app, which can't be re-signed: macOS kills any
# ad-hoc signed copy at launch (it needs CodeWeavers' provisioning-profile entitlement
# cross-architecture-support). It does have disable-library-validation, though, so it loads
# modified libraries. winemac.so (Wine's Mac driver; every process with a window, i.e. every game,
# loads it) gets a weak load command for liblsfg-metal.dylib next to it, a symlink to the fixed
# copy. Weak: if the library is missing, Wine runs without it.
patch_arm64() {
    local dir=$1/lib/wine/aarch64-unix so tmp
    so=$dir/winemac.so
    [[ -f $so ]] || return 0
    tmp="$so.lsfg-tmp"
    cp "$so" "$tmp"
    if add_weak_dylib "$tmp" "@loader_path/liblsfg-metal.dylib" \
        && codesign --force --sign - "$tmp" 2>/dev/null; then
        mv -f "$tmp" "$so"
        ln -sf "$stable_lib" "$dir/liblsfg-metal.dylib"
        touch "$1/.lsfg-metal-arm64"
    else
        rm -f "$tmp"
        print -u2 "lsfg-metal-crossover: warning: could not patch $so; ARM64 bottles are not supported"
    fi
}

setup() {
    find_app
    local src="$app/Contents/SharedSupport/CrossOver"
    print "lsfg-metal-crossover: cloning $src"
    rm -rf "$clone.tmp"
    mkdir -p "${clone:h}"
    cp -cR "$src" "$clone.tmp" 2>/dev/null || cp -R "$src" "$clone.tmp"

    local loader ent tmp
    for loader in "$clone.tmp"/lib/wine/*-unix/wine(N); do
        ent=$(mktemp -t lsfg-ent)
        codesign -d --entitlements - --xml "$loader" > "$ent" 2>/dev/null || true
        [[ -s $ent ]] || print '<?xml version="1.0" encoding="UTF-8"?><!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd"><plist version="1.0"><dict/></plist>' > "$ent"
        /usr/libexec/PlistBuddy -c "Delete :com.apple.security.cs.allow-dyld-environment-variables" "$ent" >/dev/null 2>&1 || true
        /usr/libexec/PlistBuddy -c "Add :com.apple.security.cs.allow-dyld-environment-variables bool true" "$ent"
        # sign a fresh copy and move it into place: re-signing a binary in place can leave a stale
        # cached signature for the inode, and the kernel then kills the process at launch
        tmp="$loader.lsfg-tmp"
        cp "$loader" "$tmp"
        codesign --force --sign - --options runtime --entitlements "$ent" "$tmp" 2>/dev/null
        mv -f "$tmp" "$loader"
        rm -f "$ent"
        arch -x86_64 "$loader" --version >/dev/null 2>&1 || [[ $loader == *aarch64* ]] \
            || die "patched loader does not start: $loader"
    done
    patch_arm64 "$clone.tmp"

    app_version > "$clone.tmp/.lsfg-metal-source"
    rm -rf "$clone"
    mv "$clone.tmp" "$clone"
    print "lsfg-metal-crossover: ready ($clone)"
}

ensure_setup() {
    find_app
    if [[ ! -f $clone/.lsfg-metal-source || "$(<$clone/.lsfg-metal-source)" != "$(app_version)" ]]; then
        setup
    fi
}

bottle_conf() {
    local name=$1 dir
    [[ -n $name ]] || die "missing bottle name"
    for dir in ${(s.:.)CX_BOTTLE_PATH:-"$HOME/Library/Application Support/CrossOver/Bottles"}; do
        if [[ -f $dir/$name/cxbottle.conf ]]; then print -r -- "$dir/$name/cxbottle.conf"; return; fi
    done
    die "bottle '$name' not found"
}

is_arm64() {
    grep -q '^"WineArch" *= *"arm64"' "$1"
}

# The bottle config stores an absolute path, but the installed library can move (Homebrew's
# Cellar path changes with every upgrade, and the old one is deleted by cleanup). Bottles therefore
# point at a copy in a fixed place, refreshed from the installed library. The copy is written to a
# temporary file and renamed, so games that are running keep their mapped (old) file.
install_lib() {
    if [[ -n $lib && -f $lib && $lib != "$stable_lib" ]] && ! cmp -s "$lib" "$stable_lib"; then
        mkdir -p "${stable_lib:h}"
        cp "$lib" "$stable_lib.tmp"
        mv -f "$stable_lib.tmp" "$stable_lib"
    fi
    [[ -f $stable_lib ]] || die "liblsfg-metal.dylib not found (use --lib)"
}

# path of the library the bottle is enabled with (empty if not enabled)
conf_lib() {
    grep -m1 "$conf_re" "$1" | sed 's/^"DYLD_INSERT_LIBRARIES" = "\(.*\)"$/\1/'
}

add_conf() {
    local conf=$1 line="\"DYLD_INSERT_LIBRARIES\" = \"$stable_lib\""
    disable_conf "$conf"
    if grep -q '^\[EnvironmentVariables\]' "$conf"; then
        awk -v l="$line" '{ print } /^\[EnvironmentVariables\]/ { print l }' "$conf" > "$conf.lsfg-tmp"
    else
        { cat "$conf"; print "\n[EnvironmentVariables]\n$line" } > "$conf.lsfg-tmp"
    fi
    mv -f "$conf.lsfg-tmp" "$conf"
}

enable() {
    local conf=$(bottle_conf "$1")
    install_lib
    cp -p "$conf" "$conf.lsfg-metal-backup"
    add_conf "$conf"
    print "lsfg-metal-crossover: enabled in $conf (backup: $conf.lsfg-metal-backup)"
}

disable_conf() {
    grep -v "$conf_re" "$1" > "$1.lsfg-tmp" || true
    mv -f "$1.lsfg-tmp" "$1"
}

disable() {
    local conf=$(bottle_conf "$1")
    disable_conf "$conf"
    print "lsfg-metal-crossover: disabled in $conf"
}

run() {
    while (( $# > 0 )); do
        case $1 in
            -m|--multiplier) export LSFG_METAL_ENV=1 LSFG_METAL_MULTIPLIER=$2; shift 2 ;;
            -f|--flow)       export LSFG_METAL_FLOW_SCALE=$2; shift 2 ;;
            -p|--perf)       export LSFG_METAL_PERFORMANCE_MODE=1; shift ;;
            --pacing)        export LSFG_METAL_PACING=$2; shift 2 ;;
            --dll)           export LSFG_METAL_DLL_PATH=$2; shift 2 ;;
            --log)           export LSFG_METAL_LOG=$2; shift 2 ;;
            --debug)         export LSFG_METAL_DEBUG=1; shift ;;
            --)              shift; break ;;
            -*)              die "unknown option $1" ;;
            *)               break ;;
        esac
    done
    (( $# >= 2 )) || die "usage: lsfg-metal-crossover run [options] <bottle> <program> [args...]"
    local bottle=$1; shift
    local conf=$(bottle_conf "$bottle")
    local current=$(conf_lib "$conf")
    if [[ -z $current ]]; then
        print -u2 "lsfg-metal-crossover: warning: not enabled for '$bottle' (run: lsfg-metal-crossover enable $bottle)"
        # in ARM64 bottles the clone always loads the library (see patch_arm64): keep it inert
        export LSFG_METAL_DISABLE=1
    else
        install_lib
        if [[ $current != "$stable_lib" ]]; then
            # enabled by an older version with the installed path: switch to the fixed copy
            add_conf "$conf"
            print -u2 "lsfg-metal-crossover: updated library path in $conf"
        fi
    fi
    ensure_setup
    if is_arm64 "$conf" && [[ ! -f $clone/.lsfg-metal-arm64 ]]; then
        die "this CrossOver version's Wine could not be patched for ARM64 bottles like '$bottle'"
    fi
    exec "$clone/bin/wine" --bottle "$bottle" "$@"
}

while (( $# > 0 )); do
    case $1 in
        --app) app=${2:A}; shift 2 ;;
        --lib) lib=${2:A}; shift 2 ;;
        -h|--help) sed -n '3,31p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
        *) break ;;
    esac
done

case $1 in
    setup)   setup ;;
    enable)  enable "$2" ;;
    disable) disable "$2" ;;
    run)     shift; run "$@" ;;
    *)       sed -n '3,31p' "$0" | sed 's/^# \{0,1\}//'; exit 1 ;;
esac
